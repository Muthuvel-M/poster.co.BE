generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum Size {
  A4
  A5
  A6
}

type ProductSize {
  size            Size
  price           Int
  discountedPrice Int?
}

type ProductImage {
  id        String
  url       String
  thumbUrl  String
  cardUrl   String
  sortOrder Int
}

model Admin {
  id           String   @id @default(cuid()) @map("_id")
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid()) @map("_id")
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String         @id @default(cuid()) @map("_id")
  slug        String         @unique
  title       String
  subtitle    String?
  description String
  artist      String?
  year        Int?
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  stock       Int            @default(0)
  status      ProductStatus  @default(ACTIVE)
  sizes       ProductSize[]
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
