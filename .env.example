# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (Railway auto-injects DATABASE_URL)
# Local Homebrew Postgres (user = your macOS username, no password):
DATABASE_URL=postgresql://muthu@localhost:5432/poster_co
# Docker Compose (docker compose up -d):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poster_co

# Admin bootstrap (created on first boot if no admin exists)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@poster.co
ADMIN_PASSWORD=changeme

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Cloudflare R2 (optional in dev — falls back to local uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=poster-co
R2_PUBLIC_URL=http://localhost:3001/uploads

# Local uploads directory (dev fallback)
UPLOAD_DIR=uploads
