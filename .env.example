# Server
PORT=3005
NODE_ENV=development

# MongoDB Atlas (free M0 cluster)
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/poster_co?retryWrites=true&w=majority

# Admin bootstrap (created on first boot if no admin exists)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS — store :3000, admin :3001 (+ Vercel URLs)
CORS_ORIGIN=https://poster-co.vercel.app,https://poster-co-ad.vercel.app,http://localhost:3000,http://localhost:3001
GOOGLE_CLIENT_ID=

# Local uploads fallback (only used if Cloudinary is not configured)
UPLOAD_DIR=uploads
