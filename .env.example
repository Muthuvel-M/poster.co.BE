# Server
PORT=3001
NODE_ENV=development

# MongoDB Atlas (free M0 cluster)
# Dashboard → Connect → Drivers → copy connection string, replace <password>
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/poster_co?retryWrites=true&w=majority

# Admin bootstrap (created on first boot if no admin exists)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@poster.co
ADMIN_PASSWORD=changeme

# CORS — comma-separated extra origins (poster-co.vercel.app is allowed by default)
CORS_ORIGIN=https://poster-co.vercel.app,http://localhost:5173

# Cloudflare R2 (optional in dev — falls back to local uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=poster-co
R2_PUBLIC_URL=http://localhost:3001/uploads

# Local uploads directory (dev fallback)
UPLOAD_DIR=uploads
